# ============================================================
# CONFIGURACION DE ENTORNO · Sistema Municipal de Fierros (Panuco)
# ------------------------------------------------------------
# Copia este archivo como .env y define los valores reales.
# .env NO se sube al repositorio (ver .gitignore y .vercelignore).
# En Vercel: Project -> Settings -> Environment Variables.
# ============================================================


# ------------------------------------------------------------
# FRONTEND (Vite) · las VITE_* se incrustan en el build
# ------------------------------------------------------------

# --- Google Apps Script (REQUERIDAS) ---
VITE_GOOGLE_API_URL="https://script.google.com/macros/s/XXXX/exec"
VITE_GOOGLE_TOKEN="tu_token_secreto"

# --- Firebase / Firestore (OPCIONAL) ---
# Si se omiten, la app usa Google Sheets como respaldo (Firestore se desactiva).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""


# ------------------------------------------------------------
# BACKEND (funciones serverless / Express) · SIN prefijo VITE_
# ------------------------------------------------------------

# --- Motores de IA / OCR ---

# Groq Vision (Llama 4 Scout) · Motor 0 (primario) del OCR de credencial INE.
GROQ_API_KEY=""

# Google Gemini · Motor 2 del OCR, asistente juridico, OCR historico y analisis heraldico.
GEMINI_API_KEY=""

# Microservicio PaddleOCR · Motor 1 (opcional).
# Por defecto apunta a la red local del municipio; en Vercel NO es alcanzable.
# Descomenta solo si tienes un endpoint publico accesible desde la nube.
# PADDLE_OCR_URL="http://192.168.1.13:8001/ocr"

# --- Ollama (OPCIONAL / LEGADO) ---
# La funcion callOllamaVision existe pero actualmente NO se invoca en la cascada.
# OLLAMA_URL="http://192.168.1.13:11434"
# OLLAMA_MODEL="llava:7b"
